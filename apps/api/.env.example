# =================================
# Swagger API 文件安全設定
# =================================

# Swagger 保護等級
# - basic: 基本保護（開發環境）
# - password: 密碼保護
# - ip: IP 白名單保護
# - admin: 管理員認證保護
# - time: 時間限制保護
# - full: 全套防護
# - production: 生產環境完全禁用
SWAGGER_PROTECTION_LEVEL=basic

# 密碼保護設定（當 SWAGGER_PROTECTION_LEVEL=password 或 full 時使用）
# 使用者名稱固定為 'swagger'，密碼可自訂
SWAGGER_PASSWORD=your_secure_password_here

# IP 白名單設定（當 SWAGGER_PROTECTION_LEVEL=ip 或 full 時使用）
# 多個 IP 用逗號分隔
SWAGGER_ALLOWED_IPS=127.0.0.1,::1,192.168.1.100

# 時間限制設定（當 SWAGGER_PROTECTION_LEVEL=time 或 full 時使用）
# 允許存取的小時數（24小時制），多個小時用逗號分隔
# 例如：只允許工作時間 9-17 點存取
SWAGGER_ALLOWED_HOURS=9,10,11,12,13,14,15,16,17

# API 基礎 URL（生產環境使用）
API_BASE_URL=https://api.hitcon-challenge.com

# =================================
# 其他現有環境變數
# =================================

# Database
DATABASE_URL="mongodb://localhost:27017/hitcon-challenge"

# JWT Secrets
JWT_SECRET="your-super-secret-jwt-key"
ADMIN_JWT_SECRET="your-super-secret-admin-jwt-key"

# Google OAuth
GOOGLE_CLIENT_ID="your-google-client-id"
GOOGLE_CLIENT_SECRET="your-google-client-secret"

# Server
PORT=3001
NODE_ENV=development

# CORS
ALLOWED_ORIGINS="http://localhost:3000,http://localhost:3001"

# Admin
ADMIN_PASSWORD="your-admin-password"
